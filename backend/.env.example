# Server Environment
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cam_labs_db?schema=public"

# Authentication sessions use opaque, server-side records and HttpOnly cookies.
SESSION_TTL_DAYS="30"
CORS_ORIGIN="http://localhost:3000"

# Phase 03 CAD storage and processing
CAD_STORAGE_ROOT=".data/cad-files"
CAD_MAX_FILE_SIZE_BYTES="157286400"
CAD_PROCESSING_TIMEOUT_MS="120000"
# Local scanning is deterministic development/test behavior only.
CAD_SCANNER_MODE="local"

# CAM LABS FDM estimate configuration (all active prices are EGP)
CAM_LABS_FDM_PLA_EGP_PER_GRAM="12"
CAM_LABS_FDM_ABS_EGP_PER_GRAM="15"
CAM_LABS_FDM_PETG_EGP_PER_GRAM="15"
CAM_LABS_FDM_TPU_EGP_PER_GRAM="24"
CAM_LABS_FDM_PLA_DENSITY_G_PER_CM3="1.24"
CAM_LABS_FDM_ABS_DENSITY_G_PER_CM3="1.04"
CAM_LABS_FDM_PETG_DENSITY_G_PER_CM3="1.27"
CAM_LABS_FDM_TPU_DENSITY_G_PER_CM3="1.21"
CAM_LABS_MACHINE_RATE_EGP_PER_HOUR="180"
CAM_LABS_LABOR_RATE_EGP_PER_HOUR="120"
CAM_LABS_SETUP_TIME_MINUTES="10"
CAM_LABS_PRODUCTION_LABOR_MINUTES="8"
CAM_LABS_POST_PROCESSING_MINUTES="0"
CAM_LABS_POST_PROCESSING_STANDARD_EGP="0"
CAM_LABS_POST_PROCESSING_SMOOTH_EGP="0"
CAM_LABS_SETUP_CONSUMABLES_EGP="0"
CAM_LABS_MINIMUM_ORDER_EGP="0"
CAM_LABS_WASTE_FACTOR_PERCENT="8"
CAM_LABS_SUPPORT_SURFACE_FRACTION_FACTOR="1"
CAM_LABS_SUPPORT_VOLUME_FACTOR="0.35"
CAM_LABS_FDM_DEFAULT_LAYER_HEIGHT_MM="0.2"
CAM_LABS_FDM_DEFAULT_INFILL_PERCENT="20"
CAM_LABS_FDM_DEFAULT_WALL_COUNT="2"
CAM_LABS_FDM_DEFAULT_LINE_WIDTH_MM="0.45"
CAM_LABS_FDM_DEFAULT_PRINT_SPEED_MM_S="50"
CAM_LABS_FDM_PER_LAYER_OVERHEAD_SECONDS="0.04"
CAM_LABS_FDM_TRAVEL_OVERHEAD_PERCENT="15"
CAM_LABS_MESH_DEFAULT_UNIT="mm"

