datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  role          String    @default("CUSTOMER")
  accountStatus String    @default("ACTIVE")
  company       String    @default("Independent")
  phone         String?
  avatar        String?
  tier          String    @default("Pro Engineer")
  address       String?
  taxId         String?
  passwordHash  String?
  // Stable Google Identity Services subject. Lets email changes stay safe
  // for OAuth users: Google sign-in matches by sub first, email second.
  googleSub     String?   @unique
  preferences   Json?     // { units: "mm", toleranceStandard: "ISO 2768-fine", ... }
  // Two-factor authentication (TOTP). Secrets are server-only and never
  // exposed via toSafeUser; only twoFactorEnabled is visible to clients.
  twoFactorEnabled          Boolean   @default(false)
  twoFactorSecret           String?
  twoFactorPendingSecret    String?
  twoFactorPendingExpiresAt DateTime?
  twoFactorBackupCodes      Json?     // sha256 hashes of single-use backup codes
  lastActivityAt DateTime?
  // Admin-specific fields
  isAdmin       Boolean   @default(false)
  adminPermissions Json?  // Array of permission strings for granular access control
  adminNotes    String?   // Notes about admin user
  lastLoginAt   DateTime?
  failedLoginAttempts Int @default(0)
  lockedUntil   DateTime?
  governorate   String?
  city          String?
  addressLine1  String?
  addressLine2  String?
  postalCode    String?
  country       String?   @default("Egypt")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders        Order[]
  quotes        Quote[]
  cadFiles      CadFile[]
  technicalDocuments TechnicalDocument[]
  sessions      Session[]
  passwordResetChallenges PasswordResetChallenge[]
  emailChangeChallenges EmailChangeChallenge[]
  auditLogs     AuditLog[]
  notifications AdminNotification[]
  payments      Payment[]
  couponUsages  CouponUsage[]

  @@index([role])
  @@index([accountStatus])
  @@index([isAdmin])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Device metadata captured at creation for the account security panel.
  // Nullable so pre-existing rows remain valid; never trusted for auth.
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetChallenge {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeDigest          String
  expiresAt           DateTime
  attempts            Int       @default(0)
  verifiedAt          DateTime?
  resetTokenDigest    String?
  resetTokenExpiresAt DateTime?
  usedAt              DateTime?
  createdAt           DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_challenges")
}

// Verified email-change flow (Account Settings → Work Email → Change).
// Mirrors the password-reset security model: the 6-digit OTP is stored only
// as an HMAC digest, single-use transitions use conditional writes, and the
// target address is bound into the challenge so a code cannot be replayed
// against a different address.
model EmailChangeChallenge {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail    String
  codeDigest  String
  expiresAt   DateTime
  attempts    Int       @default(0)
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("email_change_challenges")
}
model Material {
  id                 String    @id
  name               String
  technology         String   // SLS, SLA, FDM, CNC, DMLS, Sheet Metal
  category           String   // Polymers, High-Performance, Metals, Resins, Elastomers
  description        String
  tensileStrength    Float    // MPa
  hdt                Float    // °C
  elongation         Float    // %
  density            Float    // g/cm³
  standardTolerance  String
  minWallThickness   String
  leadTime           String
  surfaceFinish      String
  tags               String[]
  colorOptions       String[]
  idealFor           String
  isCertified        Boolean   @default(true)
  pricePerUnit       Float?
  priceUnit          String?   // EGP/g, EGP/hour
  availability       String    @default("IN_STOCK")
  isActive           Boolean   @default(true)
  archivedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("materials")
}

model Order {
  id                String   @id // e.g. CAM-2026-8894 (CAM LABS Internal ID)
  reference         String?  @unique // Unified business reference CAM-2026-XXXXXX, shared with source Quote
  userId            String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  quoteId           String?
  partName          String
  technology        String
  material          String
  quantity          Int      @default(1)
  date              String
  estDelivery       String
  status            String   @default("In Review") // In Review, In Production, Quality Inspection, Delivered
  statusBadge       String   @default("badge-blue")
  progressStep      Int      @default(1)
  manufacturingCost String?
  serviceFee        String?
  totalCost         String
  tolerance         String   @default("±0.05 mm")
  provider          String   @default("CAM LABS") // Historical field; active engine is CAM LABS
  providerOrderRef  String?  // Historical provider reference; active orders use internalOrderRef
  trackingNum       String?  // Historical external tracking field; active orders use CAM LABS tracking
  history           Json     // Array of { step, date, done, desc }
  paymentStatus     String   @default("Pending")
  preferredPaymentMethod String? // CUSTOMER_PREFERRED: KASHIER | COD (stored at quote, carried to order)
  manufacturingStatus String @default("Pending")
  shippingStatus    String   @default("Pending")
  shippingAddress   String?
  shippingMethod    String?
  shippingCost      String?
  shippingCostAmount Float?  @default(0)
  carrier           String?
  actualDelivery    String?
  shippingAddressSnapshot Json?
  billingAddressSnapshot  Json?
  contactSnapshot         Json?
  couponId          String?
  coupon            Coupon?  @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCodeSnapshot String?
  couponDiscountTypeSnapshot String?
  couponDiscountValueSnapshot Float?
  couponEligibleAmountSnapshot Float?
  couponDiscountAmountApplied Float? @default(0)
  manufacturerId    String?
  manufacturer      Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  pricingEquationVersionId String?
  pricingEquationVersion   PricingEquationVersion? @relation(fields: [pricingEquationVersionId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  technicalNotes    String   @default("")   // Customer technical notes shipped with the order
  cadFiles          OrderCadFile[]
  technicalDocuments TechnicalDocument[]
  events            OrderEvent[]
  manufacturingRequests ManufacturingRequest[]
  payments          Payment[]

  @@index([manufacturerId])
  @@index([userId])
  @@index([pricingEquationVersionId])
  @@index([status])
  @@map("orders")
}

model OrderCadFile {
  orderId   String
  cadFileId String
  configuration Json?
  totalCost     String?
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cadFile   CadFile @relation(fields: [cadFileId], references: [id], onDelete: Restrict)

  @@id([orderId, cadFileId])
  @@index([cadFileId])
  @@map("order_cad_files")
}

model Quote {
  id                String   @id // e.g. RFQ-2026-7741 (CAM LABS Internal Quote ID)
  reference         String?  @unique // Unified immutable business reference CAM-2026-XXXXXX, shared with future Order
  userId            String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  partName          String
  technology        String
  material          String
  quantity          Int      @default(1)
  toleranceGrade    String?  @default("standard")
  surfaceFinish     String?  @default("Standard")
  manufacturingCost String?  // Historical manufacturing cost field
  serviceFee        String?  // Historical field retained for quote data integrity; unused by active pricing
  unitPrice         String
  totalPrice        String
  leadTime          String
  validUntil        String   // 14-day validity
  status            String   @default("Ready for Approval")
  provider          String   @default("CAM LABS") // Historical field; active quotes are CAM LABS quotes
  providerQuoteRef  String?  // Historical field; active quotes store an internal CAM LABS quote reference
  isSimulated       Boolean  @default(false)
  cadFileIds        Json?    // CAD files included in the authoritative quotation
  pricingBreakdown  Json?    // Authoritative CAM LABS cost components and value sources
  pricingEquationVersionId String?
  pricingEquationVersion   PricingEquationVersion? @relation(fields: [pricingEquationVersionId], references: [id], onDelete: SetNull)
  convertedOrderId  String?
  // ── Submit Quote snapshots (immutable per-quote) ──
  contactName       String?
  contactEmail      String?
  contactPhone      String?
  contactSnapshot   Json?
  country           String?  @default("Egypt")
  governorate       String?
  city              String?
  addressLine1      String?
  addressLine2      String?
  postalCode        String?
  shippingAddressSnapshot Json?
  shippingMethod    String?  @default("STANDARD")
  shippingCostAmount Float?  @default(0)
  preferredPaymentMethod String? // KASHIER | COD (preference only — no charge at quote stage)
  billingSameAsShipping Boolean @default(true)
  billingAddressSnapshot  Json?
  couponId          String?
  coupon            Coupon?  @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCodeSnapshot String?
  couponDiscountTypeSnapshot String? // PERCENTAGE | FIXED
  couponDiscountValueSnapshot Float?
  couponEligibleAmountSnapshot Float?
  couponDiscountAmountApplied Float? @default(0)
  couponShippingDiscountApplied Float? @default(0)
  estimatedTotalAmount Float?
  couponAppliedAt   DateTime?
  couponUsages      CouponUsage[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  technicalNotes    String   @default("")   // Customer technical notes at quotation time
  technicalDocuments TechnicalDocument[]
  messages          QuoteMessage[]
  deletionRequests  QuoteDeletionRequest[]
  // Manual price override (engine snapshot in pricingBreakdown is never mutated)
  systemTotalPrice  String?   // Engine-calculated total at first override time
  priceOverrideReason String? // Required admin justification
  priceOverriddenBy String?   // Admin user id
  priceOverriddenAt DateTime?
  // Status change audit (Quote has no event stream; AuditLog is the record)
  statusReason      String?
  statusUpdatedAt   DateTime?
  statusUpdatedBy   String?

  @@index([userId])
  @@index([pricingEquationVersionId])
  @@map("quotes")
}

model CadFile {
  id             String   @id @default(uuid())
  userId         String?
  guestId        String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name           String
  format         String   // STEP, STL, DXF, IGES
  size           String
  uploaded       String
  volume         String
  dimensions     String
  meshTriangles  String
  status         String   @default("Verified CAD")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  versions       CadFileVersion[]
  orders         OrderCadFile[]

  @@index([userId, updatedAt])
  @@index([guestId, updatedAt])

  @@map("cad_files")
}

model CadFileVersion {
  id                String              @id @default(uuid())
  cadFileId         String
  cadFile           CadFile             @relation(fields: [cadFileId], references: [id], onDelete: Cascade)
  version           Int
  originalName      String
  format            String
  mimeType          String
  byteSize          Int
  checksum          String
  storageKey        String              @unique
  uploadStatus      String              @default("STORED")
  scanStatus        String              @default("PENDING")
  processingStatus  String              @default("PENDING")
  metadata          Json?
  dimensions        String?
  volume            String?
  meshTriangles     String?
  viewerAssetKey    String?
  viewerAssetSize   Int?
  processingDuration Int?
  detectedUnit      String?
  failureCode       String?
  failureMessage    String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  jobs              CadProcessingJob[]
  dfmReport         DfmReport?

  @@unique([cadFileId, version])
  @@unique([cadFileId, checksum])
  @@index([cadFileId, createdAt])
  @@index([processingStatus, scanStatus])
  @@map("cad_file_versions")
}

model CadProcessingJob {
  id          String          @id @default(uuid())
  versionId   String
  version     CadFileVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  operation   String
  status      String          @default("PENDING")
  attempts    Int             @default(0)
  maxAttempts Int             @default(3)
  availableAt DateTime        @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  lastError   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([versionId, operation])
  @@index([status, availableAt])
  @@map("cad_processing_jobs")
}

model DfmReport {
  id          String         @id @default(uuid())
  versionId   String         @unique
  version     CadFileVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  status      String
  summary     Json
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("dfm_reports")
}

model PricingEquation {
  id                   String                  @id @default(uuid())
  technology           String                  @unique // FDM, SLA, SLS, CNC_MILLING, CNC_TURNING, LASER_CUTTING
  name                 String
  description          String?
  currentPublishedId   String?
  draftVersionId       String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  versions             PricingEquationVersion[]
  publications         PricingPublication[]
  tests                PricingTest[]

  @@map("pricing_equations")
}

model PricingEquationVersion {
  id                   String             @id @default(uuid())
  equationId           String
  equation             PricingEquation    @relation(fields: [equationId], references: [id], onDelete: Cascade)
  version              Int
  status               String             // DRAFT, PUBLISHED, ARCHIVED
  name                 String?
  description          String?
  formulaTree          Json               // Root AST expression
  customVariables      Json?              // Array of { code, name, description, unit, dataType, formulaTree, dependencies, isEnabled }
  constantsSnapshot    Json?              // Snapshot of { [key: string]: { value: number, unit: string, description?: string } }
  breakdownConfig      Json?              // Custom breakdown mappings
  publishedAt          DateTime?
  publishedBy          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  publications         PricingPublication[]
  quotes               Quote[]
  orders               Order[]

  @@unique([equationId, version])
  @@index([equationId, status])
  @@map("pricing_equation_versions")
}

model PricingVariable {
  id                   String             @id @default(uuid())
  technology           String?            // null = global, or technology name
  code                 String             @unique // e.g. "Weight", "Volume", "MachineTime"
  name                 String
  description          String?
  type                 String             // PREDEFINED, CUSTOM
  unit                 String             // mm, mm2, mm3, g, kg, hour, minute, second, EGP, percentage, unitless
  dataType             String             @default("number") // number, boolean, string
  formulaTree          Json?              // AST if custom
  dependencies         String[]           @default([])
  isEnabled            Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@map("pricing_variables")
}

model PricingConstant {
  id                   String             @id @default(uuid())
  technology           String?            // null = global, or technology name
  key                  String             @unique // e.g. "PLA_PRICE", "MACHINE_HOURLY_RATE", "PROFIT_MARGIN"
  name                 String
  value                Float
  unit                 String             // EGP/g, EGP/hour, percentage, etc.
  description          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@map("pricing_constants")
}

model PricingTest {
  id                   String             @id @default(uuid())
  equationId           String
  equation             PricingEquation    @relation(fields: [equationId], references: [id], onDelete: Cascade)
  technology           String
  cadFileId            String?
  inputParams          Json               // { materialId, infill, layerHeight, quantity, etc. }
  draftResult          Json?              // Output & breakdown of draft calculation
  publishedResult      Json?              // Output & breakdown of published calculation
  comparison           Json?              // { diffEgp, percentDiff, itemizedDiff }
  createdAt            DateTime           @default(now())

  @@index([equationId, createdAt])
  @@map("pricing_tests")
}

model PricingPublication {
  id                   String                 @id @default(uuid())
  equationId           String
  equation             PricingEquation        @relation(fields: [equationId], references: [id], onDelete: Cascade)
  versionId            String
  version              PricingEquationVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  publishedBy          String
  notes                String?
  snapshot             Json                   // Full snapshot of equation AST, custom variables, constants
  publishedAt          DateTime               @default(now())

  @@index([equationId, publishedAt])
  @@map("pricing_publications")
}

// Admin Panel Models

model Manufacturer {
  id                  String   @id @default(uuid())
  companyName         String   @unique
  contactPerson       String
  email               String
  phone               String?
  location            String?
  address             String?
  supportedTechnologies String[] // ["FDM", "SLA", "SLS", "CNC_MILLING", "CNC_TURNING", "LASER_CUTTING"]
  supportedMaterials  String[]
  capacity            Int?     // Maximum concurrent orders
  availability        String   @default("AVAILABLE") // AVAILABLE, BUSY, OFFLINE
  currentOrders       Int      @default(0)
  completedOrders     Int      @default(0)
  performanceRating   Float?   // 0-5 scale
  status              String   @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  orders              Order[]
  manufacturingRequests ManufacturingRequest[]

  @@index([status])
  @@index([availability])
  @@map("manufacturers")
}

model ManufacturingRequest {
  id                  String   @id @default(uuid())
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  manufacturerId      String?
  manufacturer        Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  technology          String
  material            String
  quantity            Int
  requiredDate        String?
  status              String   @default("PENDING") // PENDING, ACCEPTED, REJECTED, IN_PROGRESS, COMPLETED, CANCELLED
  createdAt           DateTime @default(now())
  acceptedAt          DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  notes               String?
  estimatedCompletion String?
  actualCompletion    String?

  @@index([orderId])
  @@index([manufacturerId])
  @@index([status])
  @@map("manufacturing_requests")
}

model OrderEvent {
  id                  String   @id @default(uuid())
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventType           String   // ORDER_CREATED, CAD_UPLOADED, QUOTE_GENERATED, ORDER_CONFIRMED, MANUFACTURER_ASSIGNED, PRODUCTION_STARTED, PRODUCTION_COMPLETED, QA_PASSED, QA_FAILED, SHIPPED, DELIVERED, CANCELLED
  description         String
  metadata            Json?
  createdAt           DateTime @default(now())

  @@index([orderId])
  @@index([eventType])
  @@index([createdAt])
  @@map("order_events")
}

model Payment {
  id                  String   @id @default(uuid())
  orderId             String?
  order               Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  userId              String?
  user                User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  amount              Float
  currency            String   @default("EGP")
  paymentMethod       String?  // CREDIT_CARD, BANK_TRANSFER, CASH, etc.
  paymentStatus       String   @default("PENDING") // PENDING, PAID, FAILED, REFUNDED, PARTIALLY_REFUNDED
  transactionId       String?  @unique
  refundedAmount      Float?   @default(0)
  refundReason        String?
  metadata            Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([paymentStatus])
  @@map("payments")
}

model AuditLog {
  id                  String   @id @default(uuid())
  userId              String?
  user                User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action              String   // CREATE, UPDATE, DELETE, PUBLISH, ASSIGN, etc.
  entityType          String   // ORDER, QUOTE, USER, MANUFACTURER, PRICING_CONSTANT, etc.
  entityId            String?
  oldValue            Json?
  newValue            Json?
  ipAddress           String?
  userAgent           String?
  sessionId           String?
  metadata            Json?
  createdAt           DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model AdminNotification {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // QUOTE, ORDER, USER_REGISTERED, USER_LOGIN, MANUFACTURING_REQUEST, PAYMENT, SYSTEM, ...
  title       String
  message     String
  metadata    Json?
  entityType  String?  // QUOTE, ORDER, USER, PAYMENT, MANUFACTURING_REQUEST, ...
  entityId    String?  // navigation target id of entityType
  isRead      Boolean  @default(false)
  priority    String   @default("INFO") // INFO, WARNING, ERROR, SUCCESS
  createdAt   DateTime @default(now())
  readAt      DateTime?

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("admin_notifications")
}

model SystemSetting {
  key         String   @id
  group       String
  value       Json
  description String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([group])
  @@map("system_settings")
}

model ShippingMethod {
  id          String    @id @default(uuid())
  code        String    @unique // e.g. STANDARD, PRIORITY (client submits the code; server resolves the price)
  name        String    // e.g. Standard Shipping
  description String    @default("")
  eta         String    @default("") // delivery estimate label, e.g. 2–5 Days
  priceEgp    Float
  currency    String    @default("EGP")
  isEnabled   Boolean   @default(true)
  sortOrder   Int       @default(0)
  archivedAt  DateTime? // soft-delete; historical quote snapshots are preserved
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isEnabled])
  @@index([sortOrder])
  @@map("shipping_methods")
}

model TechnicalDocument {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestId    String?
  quoteId    String?
  quote      Quote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  orderId    String?
  order      Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  name       String
  mimeType   String
  byteSize   Int
  checksum   String
  storageKey String   @unique
  scanStatus String   @default("CLEAN")
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([guestId])
  @@index([quoteId])
  @@index([orderId])
  @@map("technical_documents")
}

model QuoteMessage {
  id        String   @id @default(uuid())
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  senderId  String?
  subject   String?
  message   String
  createdAt DateTime @default(now())

  @@index([quoteId])
  @@map("quote_messages")
}

// Customer Quote deletion requests (Phase: deletion-by-approval).
// Customers can never delete a Quote directly — they file a request that an
// authorized admin reviews (APPROVE deletes the Quote transactionally,
// REJECT keeps it active). At most one PENDING request per Quote (enforced
// by a partial unique index in the migration + server-side check).
model QuoteDeletionRequest {
  id                String    @id @default(uuid())
  quoteId           String?
  quote             Quote?    @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  requestedByUserId String
  status            String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reason            String?
  // Immutable snapshots for audit history (survive Quote removal on approve).
  quoteReference    String?
  quotePartName     String?
  customerName      String?
  customerEmail     String?
  requestedAt       DateTime  @default(now())
  reviewedAt        DateTime?
  reviewedByAdminId String?
  adminNote         String?

  @@index([quoteId])
  @@index([requestedByUserId])
  @@index([status])
  @@map("quote_deletion_requests")
}

model Coupon {
  id                   String   @id @default(uuid())
  code                 String   @unique // e.g. CAM20 (stored upper-cased, trimmed)
  discountType         String   // PERCENTAGE | FIXED
  discountValue        Float    // percent (0-100) or fixed EGP amount
  maxDiscountAmount    Float?   // cap for percentage discounts (EGP)
  minQuoteAmount       Float?   // minimum eligible subtotal (EGP)
  maxTotalUses         Int?     // null = unlimited
  usageLimitPerCustomer Int?    // null = unlimited
  startAt              DateTime?
  expiresAt            DateTime?
  isEnabled            Boolean  @default(true)
  discountScope        String   @default("SUBTOTAL_ONLY") // SUBTOTAL_ONLY | INCLUDING_SHIPPING
  appliesToShipping    Boolean  @default(false)
  totalUses            Int      @default(0) // atomic counter for concurrency-safe limits
  createdBy            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  archivedAt           DateTime? // soft-delete / archival, preserves history

  quotes               Quote[]
  orders               Order[]
  usages               CouponUsage[]

  @@index([code])
  @@index([isEnabled])
  @@index([expiresAt])
  @@map("coupons")
}

model CouponUsage {
  id                          String   @id @default(uuid())
  couponId                    String
  coupon                      Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  userId                      String?
  user                        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  quoteId                     String?
  quote                       Quote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  couponCodeSnapshot          String
  discountTypeSnapshot        String
  discountValueSnapshot       Float
  eligibleAmountSnapshot      Float
  discountAmountApplied       Float
  amountAfterDiscount         Float
  shippingDiscountApplied     Float    @default(0)
  quoteReference              String?
  createdAt                   DateTime @default(now())

  @@index([couponId])
  @@index([userId])
  @@index([quoteId])
  @@index([createdAt])
  @@map("coupon_usages")
}

